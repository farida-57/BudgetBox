# BudgetBox API — variables d'environnement
# Copier ce fichier en `.env` et remplir les valeurs. Ne jamais committer `.env`.

# Environnement : development | test | production
NODE_ENV=development

# Port d'écoute de l'API
PORT=3000

# Chaîne de connexion MongoDB (Atlas ou local)
MONGODB_URI=mongodb://localhost:27017/budgetbox

# Secret de signature des jetons d'accès JWT (32 caractères minimum, aléatoire)
JWT_ACCESS_SECRET=change-me-with-a-long-random-string

# Durée de vie du jeton d'accès (ex. 15m, 1h)
ACCESS_TOKEN_TTL=15m

# Durée de vie du jeton de rafraîchissement en jours
REFRESH_TOKEN_TTL_DAYS=30

# Durée de vie d'une invitation de groupe en heures (7 jours = 168)
INVITATION_TTL_HOURS=168

# Origines autorisées pour CORS (séparées par des virgules, * en dev)
CORS_ORIGIN=*
